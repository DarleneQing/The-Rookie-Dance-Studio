NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# REQUIRED for email verification in production!
# This is used for email verification and password reset redirect URLs
# In development: http://localhost:3000
# In production: https://therookiestudio.ch (or your actual domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Google Apps Script endpoint for idempotent class closeout snapshots.
FINANCE_CLOSEOUT_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
FINANCE_CLOSEOUT_WEBHOOK_SECRET=replace-with-a-long-random-secret

